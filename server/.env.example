# ===================================================
# ADAMAS UNIVERSITY E-CLUB API SERVER ENVIRONMENT
# ===================================================

PORT=5000
NODE_ENV=development

# Supabase Credentials (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Admin Sessions
JWT_SECRET=adamas_eclub_secure_jwt_secret_key_2026

# Admin Fallback Credentials (Used if database admin table is unseeded)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email Dispatch Configuration (Gmail SMTP)
# To send emails from the server:
# 1. Enable 2-Step Verification in Google Account -> Generate an App Password (16 letters)
# 2. Add credentials below:
EMAIL_USER=adamaseclub@gmail.com
EMAIL_PASS=your-google-app-password
NOTIFICATION_EMAIL=adamaseclub@gmail.com
ENABLE_RATING_EMAILS=false

